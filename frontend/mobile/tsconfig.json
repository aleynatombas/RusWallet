{
  "compilerOptions": {
    "strict": true,
    "rootDir": "./src",
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "**/node_modules"
  ]
}