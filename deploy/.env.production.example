# VPS Docker için — kopyala: deploy/.env.production
MSSQL_SA_PASSWORD=ChangeMe_Strong_Password_123!
API_CONNECTION_STRING=Server=sql,1433;Database=RusWalletDb;User Id=sa;Password=ChangeMe_Strong_Password_123!;TrustServerCertificate=True;Encrypt=False
JWT_KEY=REPLACE_WITH_64_CHAR_RANDOM_SECRET________________________________
WEB_ORIGIN=https://app.example.com

# --- Yedekleme (scripts/backup-sql.sh) ---
# SQL servisinin Docker Compose proje/servis adı (backup script `docker compose exec` ile kullanır)
COMPOSE_SQL_SERVICE=sql
# rclone crypt remote adı (önce `rclone config` ile B2 remote + crypt remote oluşturulmalı)
RCLONE_REMOTE=b2crypt:ruswallet-backups
# rclone config dosyasının VPS'teki yolu (gizli, repo dışında tutulur)
RCLONE_CONFIG_PATH=/etc/ruswallet/rclone.conf
# healthchecks.io ping URL'leri (proje panelinden alınır)
HEALTHCHECK_PING_URL=https://hc-ping.com/REPLACE_WITH_UUID
HEALTHCHECK_PING_FAIL_URL=https://hc-ping.com/REPLACE_WITH_UUID/fail
# Yerel yedeklerin tutulacağı retention gün sayısı
BACKUP_RETENTION_DAYS=7
